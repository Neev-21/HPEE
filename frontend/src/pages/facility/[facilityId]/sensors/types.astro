---
import AppLayout from '../../../../layouts/AppLayout.astro';
import { SensorTypeManager } from '../../../../components/react/sensors/SensorTypeManager';

export function getStaticPaths() {
  return [{ params: { facilityId: 'demo' } }];
}

const { facilityId } = Astro.params;
---

<AppLayout title="Manage Sensor Types | HPEE">
  <div class="mb-6">
    <a href={`/facility/${facilityId}/sensors`} class="text-slate-500 hover:text-slate-700 font-medium text-sm mb-4 inline-block">
      ← Back to Sensors
    </a>
    <h1 class="text-2xl font-bold text-slate-900">Manage Sensor Types</h1>
  </div>
  
  <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
    <p class="text-slate-500 italic">&lt;SensorTypeManager client:load /&gt; would be mounted here.</p>
  </div>
  <SensorTypeManager client:load />
</AppLayout>
