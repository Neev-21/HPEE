---
import AppLayout from '../../../layouts/AppLayout.astro';
import { BlueprintEditor } from '../../../components/react/blueprint/BlueprintEditor';

export function getStaticPaths() {
  return [{ params: { facilityId: 'demo' } }];
}

const { facilityId } = Astro.params;
---

<AppLayout title="Blueprint Editor | HPEE">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-900">Blueprint Editor</h1>
  <div class="mb-4 flex justify-between items-center">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Facility Blueprint Editor</h1>
      <p class="text-sm text-slate-500 mt-0.5">Drag and drop sensor nodes and draw operational zones on your facility layout.</p>
    </div>
    <div class="flex gap-3">
      <a href={`/facility/${facilityId}/sensors`} class="text-sm font-medium text-blue-600 hover:text-blue-800">
        View Sensor Table →
      </a>
    </div>
  </div>
  
  <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm min-h-[500px]">
    <p class="text-slate-500 italic">&lt;BlueprintEditor client:load facilityId="{facilityId}" /&gt; would be mounted here.</p>
  </div>
  <BlueprintEditor client:load facilityId={facilityId} />
</AppLayout>
