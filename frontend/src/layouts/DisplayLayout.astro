---
import '../styles/global.css';
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - Plant Display</title>
</head>
<body class="bg-black text-white font-sans antialiased h-screen w-screen overflow-hidden">
    <slot />
</body>
</html>
